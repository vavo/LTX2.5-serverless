{
  "title": "LTX 2.5 ComfyUI Worker",
  "description": "Run Blackwell-first LTX 2.5 video inference on ComfyUI with persistent /workspace state",
  "type": "serverless",
  "category": "image",
  "iconUrl": "https://cpjrphpz3t5wbwfe.public.blob.vercel-storage.com/comfy-ui.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 120,
    "gpuIds": "BLACKWELL_180",
    "gpuCount": 1,
    "allowedCudaVersions": ["13.0", "12.8"],
    "env": [
      {
        "key": "LTX25_PRELOAD_VARIANT",
        "input": {
          "name": "LTX 2.5 Model Profile",
          "type": "string",
          "description": "Startup preload profile: distilled-int8",
          "default": "distilled-int8",
          "advanced": false
        }
      },
      {
        "key": "PERSIST_WORKSPACE",
        "input": {
          "name": "Persist /workspace",
          "type": "boolean",
          "description": "Store ComfyUI, venv, caches, and downloaded assets on the attached network volume",
          "default": true,
          "advanced": false
        }
      },
      {
        "key": "LTX25_PRELOAD_PROMPT_ENHANCER",
        "input": {
          "name": "Preload Prompt Enhancer",
          "type": "boolean",
          "description": "Also preload the Gemma prompt enhancer used by the bundled workflow",
          "default": true,
          "advanced": true
        }
      },
      {
        "key": "HUGGINGFACE_ACCESS_TOKEN",
        "input": {
          "name": "Hugging Face Token",
          "type": "string",
          "description": "Read token with accepted access to the gated LTX 2.5 model",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "R2_ACCOUNT_ID",
        "input": {
          "name": "R2 Account ID",
          "type": "string",
          "description": "Cloudflare account ID (subdomain of <id>.r2.cloudflarestorage.com)",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "R2_ACCESS_KEY_ID",
        "input": {
          "name": "R2 Access Key ID",
          "type": "string",
          "description": "R2 token with Object Read & Write on the output bucket",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "R2_SECRET_ACCESS_KEY",
        "input": {
          "name": "R2 Secret Access Key",
          "type": "string",
          "description": "Secret for the R2 token",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "RUNPOD_WEBHOOK_SECRET",
        "input": {
          "name": "Webhook Signing Secret",
          "type": "string",
          "description": "Shared HMAC secret used to sign render callbacks (32+ bytes)",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "ALLOWED_CALLBACK_ORIGIN",
        "input": {
          "name": "Allowed Callback Origin",
          "type": "string",
          "description": "Only send callbacks to this HTTPS origin (e.g. https://app.example.com)",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "ALLOWED_IMAGE_ORIGIN",
        "input": {
          "name": "Allowed Image Origin",
          "type": "string",
          "description": "Public HTTPS origin that image-to-video source images are downloaded from",
          "default": "",
          "advanced": false
        }
      },
      {
        "key": "ENABLE_KEYFRAME_GUIDES",
        "input": {
          "name": "Enable Keyframe Guides",
          "type": "boolean",
          "description": "Allow images after frame 0 (experimental until verified on GPU)",
          "default": false,
          "advanced": true
        }
      },
      {
        "key": "LTX_FRONTEND_ENABLED",
        "input": {
          "name": "Enable Debug Frontend",
          "type": "boolean",
          "description": "Start the legacy debug frontend on :7777 (not used by the scene/concat contract)",
          "default": false,
          "advanced": true
        }
      },
      {
        "key": "COMFY_LOG_LEVEL",
        "input": {
          "name": "ComfyUI Log Level",
          "type": "string",
          "description": "Log level for ComfyUI (DEBUG, INFO, WARNING, ERROR, CRITICAL)",
          "default": "DEBUG",
          "advanced": true
        }
      },
      {
        "key": "RUN_MODE",
        "input": {
          "name": "Runtime Mode",
          "type": "string",
          "description": "Use worker for RunPod Serverless",
          "default": "worker",
          "advanced": false
        }
      }
    ]
  }
}
